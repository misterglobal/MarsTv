#!/usr/bin/env php
<?php
declare(strict_types=1);

require dirname(__DIR__).'/src/bootstrap.php';
require dirname(__DIR__).'/src/SupportService.php';

if (PHP_SAPI !== 'cli') exit(1);
$command = $argv[1] ?? '';
$options = [];
foreach (array_slice($argv, 2) as $argument) {
    if (preg_match('/^--(device|operator|reason)=(.*)$/sD', $argument, $match)) $options[$match[1]] = $match[2];
}
try {
    if ($command !== 'test-license:grant') throw new InvalidArgumentException('Usage: php bin/marstv-support test-license:grant --device=MARS-XXXX --operator=NAME --reason="closed beta test"');
    $result = (new SupportService(database()))->grantTestLicense((string) ($options['device'] ?? ''), (string) ($options['operator'] ?? ''), (string) ($options['reason'] ?? ''));
    fwrite(STDOUT, ($result['created'] ? 'Created' : 'Existing')." test licence {$result['license']['license_uuid']} for {$result['device']['device_code']}\n");
    exit(0);
} catch (Throwable $error) {
    fwrite(STDERR, 'Failed: '.$error->getMessage()."\n");
    exit(1);
}
