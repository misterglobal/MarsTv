#!/usr/bin/env php
<?php
declare(strict_types=1);

require dirname(__DIR__).'/src/bootstrap.php';
require dirname(__DIR__).'/src/ActivationApi.php';
require dirname(__DIR__).'/src/FreemiusWebhook.php';
require dirname(__DIR__).'/src/SupportService.php';

if (PHP_SAPI !== 'cli') exit(1);
$command = $argv[1] ?? '';
$options = [];
foreach (array_slice($argv, 2) as $argument) {
    if ($argument === '--override-transfer-limit') { $options['override-transfer-limit'] = true; continue; }
    if ($argument === '--non-interactive') { $options['non-interactive'] = true; continue; }
    if (preg_match('/^--(device|operator|reason|order|email|license|new-device|event|limit)=(.*)$/sD', $argument, $match)) $options[$match[1]] = $match[2];
}
try {
    $service = new SupportService(database());
    if ($command === 'test-license:grant') {
        $result = $service->grantTestLicense((string) ($options['device'] ?? ''), (string) ($options['operator'] ?? ''), (string) ($options['reason'] ?? ''));
        fwrite(STDOUT, ($result['created'] ? 'Created' : 'Existing')." test licence {$result['license']['license_uuid']} for {$result['device']['device_code']}\n");
    } elseif ($command === 'purchase:lookup') {
        $hasOrder = isset($options['order']);
        $hasEmail = isset($options['email']);
        if ($hasOrder === $hasEmail) throw new InvalidArgumentException('Provide exactly one of --order or --email');
        $result = $hasOrder
            ? $service->lookupPurchase((string) $options['order'])
            : $service->lookupPurchasesByEmail((string) $options['email']);
        fwrite(STDOUT, json_encode($result, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_THROW_ON_ERROR)."\n");
    } elseif ($command === 'license:transfer') {
        $licenseUuid = (string) ($options['license'] ?? '');
        $newDeviceCode = (string) ($options['new-device'] ?? '');
        $preview = $service->previewTransfer($licenseUuid, $newDeviceCode);
        fwrite(STDOUT, "Transfer summary:\n");
        fwrite(STDOUT, "  Licence: {$preview['license_uuid']} ({$preview['license_status']}, version {$preview['license_version']})\n");
        fwrite(STDOUT, "  Current device: ".($preview['current_device_code'] ?? 'none')."\n");
        fwrite(STDOUT, "  New device: {$preview['new_device_code']}\n");
        if ($preview['occupying_license_uuid'] !== null && $preview['occupying_license_uuid'] !== $licenseUuid) {
            fwrite(STDOUT, "  Warning: destination has active licence {$preview['occupying_license_uuid']}\n");
        }
        $nonInteractive = (bool) ($options['non-interactive'] ?? false);
        if ($nonInteractive) {
            if (strtolower((string) env_value('MARSTV_SUPPORT_AUTOMATION_ENABLED', 'false')) !== 'true') {
                throw new RuntimeException('--non-interactive is disabled; set MARSTV_SUPPORT_AUTOMATION_ENABLED=true only in an approved automation environment');
            }
        } else {
            fwrite(STDOUT, "Type TRANSFER to continue: ");
            $confirmation = fgets(STDIN);
            if ($confirmation === false || trim($confirmation) !== 'TRANSFER') {
                throw new RuntimeException('Transfer cancelled; no changes were made');
            }
        }
        $result = $service->transferLicense(
            $licenseUuid,
            $newDeviceCode,
            (string) ($options['operator'] ?? ''),
            (string) ($options['reason'] ?? ''),
            (bool) ($options['override-transfer-limit'] ?? false),
        );
        fwrite(STDOUT, ($result['changed'] ? 'Transferred' : 'Already assigned')." licence {$result['license']['license_uuid']} to {$result['device']['device_code']} at version {$result['license']['license_version']}\n");
    } elseif ($command === 'license:revoke') {
        $result = $service->revokeLicense((string) ($options['license'] ?? ''), (string) ($options['operator'] ?? ''), (string) ($options['reason'] ?? ''));
        fwrite(STDOUT, ($result['changed'] ? 'Revoked' : 'Already revoked')." licence {$result['license']['license_uuid']} at version {$result['license']['license_version']}\n");
    } elseif ($command === 'webhook:replay') {
        $result = $service->replayWebhook((string) ($options['event'] ?? ''), (string) ($options['operator'] ?? ''), (string) ($options['reason'] ?? ''));
        fwrite(STDOUT, "Webhook replay outcome: {$result['status']}\n");
    } elseif ($command === 'webhook:work') {
        $limit = filter_var($options['limit'] ?? 25, FILTER_VALIDATE_INT, ['options' => ['min_range' => 1, 'max_range' => 100]]);
        if ($limit === false) throw new InvalidArgumentException('Worker limit must be between 1 and 100');
        $result = (new FreemiusWebhook(database()))->processDue($limit);
        fwrite(STDOUT, json_encode($result, JSON_UNESCAPED_SLASHES | JSON_THROW_ON_ERROR)."\n");
    } else {
        throw new InvalidArgumentException(
            "Commands:\n".
            "  test-license:grant --device=MARS-XXXX --operator=NAME --reason=TEXT\n".
            "  purchase:lookup (--order=PROVIDER_ORDER_ID | --email=RECEIPT_EMAIL)\n".
            "  license:transfer --license=UUID --new-device=MARS-XXXX --operator=NAME --reason=TEXT [--override-transfer-limit] [--non-interactive]\n".
            "  license:revoke --license=UUID --operator=NAME --reason=TEXT\n".
            "  webhook:replay --event=PROVIDER_EVENT_ID --operator=NAME --reason=TEXT\n".
            "  webhook:work [--limit=25]"
        );
    }
    exit(0);
} catch (Throwable $error) {
    fwrite(STDERR, 'Failed: '.$error->getMessage()."\n");
    exit(1);
}
