MARSTV_ENV=production
MARSTV_BASE_URL=https://marstv.online
MARSTV_API_BASE=/api/v1
MARSTV_SUPPORT_EMAIL=support@marstv.online
MARSTV_PRIVACY_EMAIL=privacy@marstv.online
MARSTV_PRICE_LABEL=US $12.99 one time
MARSTV_LEGAL_TERMS_VERSION=2026-09-05

MARSTV_DB_DSN=mysql:host=127.0.0.1;dbname=marstv;charset=utf8mb4
MARSTV_DB_USER=marstv_app
MARSTV_DB_PASSWORD=replace-me
MARSTV_ACTIVATION_PEPPER=replace-with-32-random-bytes-hex
MARSTV_RATE_LIMIT_PEPPER=replace-with-different-32-random-bytes-hex
MARSTV_SUPPORT_AUTOMATION_ENABLED=false

ENTITLEMENT_PRIVATE_KEY_PATH=/secure/path/outside-public-html/marstv-entitlement-private.pem
ENTITLEMENT_KEY_ID=entitlement-2026-01

FREEMIUS_CHECKOUT_ENABLED=false
FREEMIUS_MODE=sandbox
FREEMIUS_PRODUCT_ID=
FREEMIUS_PLAN_ID=
FREEMIUS_PUBLIC_KEY=
FREEMIUS_SECRET_KEY=
FREEMIUS_API_BEARER_TOKEN=
FREEMIUS_AMOUNT_MINOR=1299
FREEMIUS_CURRENCY=USD

MARSTV_APK_URL=
MARSTV_APK_VERSION=Coming soon
MARSTV_APK_SHA256=

# Self-service transfers: enable only after migration 005 and a real delivery test.
# Uses PHP mail() with your hosting provider's configured mail transport.
MARSTV_TRANSFER_PORTAL_ENABLED=false
MARSTV_TRANSFER_MAIL_FROM=support@marstv.online
# Independent random secret, at least 32 bytes.
MARSTV_TRANSFER_CODE_PEPPER=
